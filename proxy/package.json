{
  "name": "prompt-meter-proxy",
  "version": "0.1.0",
  "description": "Local HTTP proxy that meters token usage of AI coding tools and sends it to the prompt-meter ingest webhook.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "prompt-meter-proxy": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "start": "node dist/cli.js start"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
