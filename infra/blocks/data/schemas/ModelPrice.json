      "type": "Float",
      "isArray": false,
      "description": "5-minute cache write above the threshold."
    },
    {
      "name": "longContextCacheWrite1hPer1M",
      "type": "Float",
      "isArray": false,
      "description": "1-hour cache write above the threshold."
    },
    {
      "name": "fastMultiplier",
      "type": "Float",
      "isArray": false,
      "description": "Multiplier on token cost when speed is fast."
