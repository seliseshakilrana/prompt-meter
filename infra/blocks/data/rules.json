  "policies": [
    {
      "schemaName": "UsageEvent",
      "policyName": "usage-event-read",
      "policyDescription": "Owner reads own rows; team-admin reads rows of teams they administer; platform-admin reads all. Team members get nothing (they use TeamHourly).",
      "policyType": 0,
      "operation": 0,
      "ruleGroup": {
        "combinator": "or",
        "rules": [
          {
            "field": "userId",
            "operator": "equals",
            "value": "$currentUser.userId"
          },
          {
            "field": "teamId",
            "operator": "in",
            "value": "$currentUser.organizationIdsWithRole:team-admin"
          },
          {
            "currentUserRole": "platform-admin"
          }
        ]
      },
      "priority": 10,
      "isAllowPolicy": true
    },
    {
      "schemaName": "UsageEvent",
      "policyName": "usage-event-preview-owner-only",
      "policyDescription": "promptPreview column: only the row's owner, admins included in the exclusion. Fallback if CLS can't do this: UsagePreview schema (eventId, userId, preview) with owner-only RLS.",
      "policyType": 1,
      "operation": 0,
      "fieldNames": [
        "promptPreview"
      ],
      "ruleGroup": {
        "combinator": "and",
        "rules": [
          {
            "field": "userId",
            "operator": "equals",
            "value": "$currentUser.userId"
          }
        ]
      },
      "priority": 10,
      "isAllowPolicy": true
    },
