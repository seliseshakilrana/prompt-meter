VITE_BLOCKS_API_URL=https://blocksapi.slsblx.com
# This project's tenant id. Sent as the x-blocks-key header on every
# Blocks API call, and as tenant_id on the OIDC login request -- both
# mean the same thing: which Blocks tenant this app belongs to.
VITE_BLOCKS_X_BLOCKS_KEY=D056c99a5cd2a47b4bcf702d8874cf280
VITE_BLOCKS_APP_DOMAIN=https://dbbvxg-eptqw.slsblx.com
VITE_BLOCKS_OIDC_URL=https://iam.seliseblocks.com
# Public browser OIDC client (hosted IAM IdP flow, no secret). Register it in Blocks IAM
# with redirect_uris for both your dev origin and VITE_BLOCKS_APP_DOMAIN.
VITE_BLOCKS_OIDC_CLIENT_ID=e140c37a-1cc3-4edc-b77b-e00edcac0f97
VITE_BLOCKS_OIDC_SCOPE=openid profile
# Set to your project's real domain (Project/Gets -> applications[].domain,
# no scheme) to test OIDC login locally over HTTPS -- see README.md.
VITE_BLOCKS_DEV_HOST=dbbvxg-eptqw.slsblx.com
VITE_BLOCKS_DEV_PORT=5173
# Connected AI accounts. "on" requires each user to connect a Claude / Codex / Antigravity
# account before My usage opens; leave "off" until the link workflows are published.
VITE_PM_ACCOUNT_LINKING=off
# Public OAuth client ids (Google "Web application", Microsoft Entra app registration).
# Register <origin>/accounts/link/callback as a redirect URI with both providers.
VITE_PM_GOOGLE_CLIENT_ID=
VITE_PM_MICROSOFT_CLIENT_ID=
# Base URL of the published webhook workflows (link-start, link-complete, unlink-account).
VITE_PM_WORKFLOW_WEBHOOK_BASE=
